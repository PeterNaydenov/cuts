{
  "name": "@peter.naydenov/cuts",
  "description": "SPA scene manager",
  "version": "2.2.0",
  "license": "MIT",
  "author": "Peter Naydenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/cuts.git"
  },
  "homepage": "https://github.com/PeterNaydenov/cuts#readme",
  "bugs": {
    "url": "https://github.com/PeterNaydenov/cuts/issues"
  },
  "main": "./src/main.js",
  "type": "module",
  "types": "./types/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/main.d.ts",
        "default": "./src/main.js"
      },
      "require": {
        "types": "./types/main.d.cts",
        "default": "./dist/cuts.cjs"
      },
      "default": "./src/main.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "dist/cuts.cjs",
    "dist/cuts.esm.mjs",
    "dist/cuts.umd.js",
    "types/main.d.ts",
    "types/main.d.cts",
    "skills",
    "Changelog.md",
    "Migration.guide.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.build.config.js && vite build --config vite.build.config.js --mode umd",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:build": "npm run build && node --test test-build/artifacts.js",
    "test:e2e": "playwright test",
    "cover": "vitest run --coverage"
  },
  "devDependencies": {
    "@peter.naydenov/visual-controller-for-vue3": "^3.0.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@peter.naydenov/log": "^1.1.3",
    "@peter.naydenov/shortcuts": "^4.2.0",
    "ask-for-promise": "^3.2.2"
  },
  "keywords": [
    "script",
    "visual",
    "state",
    "manager"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
